    <statement><p>Select <alert>all</alert> expressions that are equivalent to  
<me>\displaystyle y + \frac{y}{5} + \frac{5}{y}.</me>  
There may be more than one correct answer.</p>
<p><var form="checkboxes">
<li>
<p><m>\displaystyle \frac{6 y^2 + 25}{5 y}</m></p>
</li>
<li>
<p><m>\displaystyle y + 5</m></p>
</li>
<li>
<p><m>\displaystyle \frac{2y + 5}{5 + y}</m></p>
</li>
<li>
<p><m>\displaystyle \frac{6 y}{5} + \frac{5}{y}</m></p>
</li>
<li>
<p><m>\displaystyle \frac{y^2 + 25}{5 y }</m></p>
</li>
</var></p>
</statement>
