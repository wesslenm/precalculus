  <static seed="50" source="Library/PCC/BasicAlgebra/AlgebraicProperties/ExpressionAlgebraSkill50.pg">
    <statement><p>Simplify the following expression.</p>
<p><m>\displaystyle{ {2m^{2}a^{3}\mathopen{}\left(-3m^{4}a^{2}\right)^{3}}=}</m><fillin characters="14" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>-54m^{14}a^{9}</m>
      </p>
    </answer>
    <solution><p><m>\displaystyle{ 
\begin{aligned}
   {2m^{2}a^{3}\mathopen{}\left(-3m^{4}a^{2}\right)^{3}}
   \amp = {2m^{2}a^{3}}(-3)^{3}({m^{4}})^{3}({a^{2}})^{3} \\
   \amp = {2m^{2}a^{3}}(-27)(m^{12})(a^{6}) \\
   \amp = {-54m^{14}a^{9}} \\
\end{aligned}
    }</m></p>
</solution>
  </static>
