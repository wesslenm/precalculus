    <statement><p>Select <alert>all</alert> expressions that are equivalent to 
<me>\frac{x-2}{7 x} \cdot  \frac{x}{x^2-4}</me>
There may be more than one correct answer.</p>
<p><var form="checkboxes">
<li>
<p><m>\displaystyle \frac{1}{7(x+2)}</m></p>
</li>
<li>
<p><m>\displaystyle \frac{-1}{7(x-2)}</m></p>
</li>
<li>
<p><m>\displaystyle \frac{-1}{7 x-2}</m></p>
</li>
<li>
<p><m>\displaystyle \frac{1}{7} \cdot \frac{1}{x+2}</m></p>
</li>
<li>
<p>None of the above</p>
</li>
</var></p>
</statement>
